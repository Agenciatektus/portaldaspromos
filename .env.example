# ============================================================
# Portal de Promos — Variáveis de Ambiente
# Copie este arquivo para .env e preencha os valores
# NUNCA commite o arquivo .env no git
# ============================================================

# --- Google OAuth (YouTube) ---
# Obtido em: Google Cloud Console → Credenciais → OAuth 2.0
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Gerado automaticamente ao rodar: npm run auth:youtube
YOUTUBE_REFRESH_TOKEN=

# --- Google Service Account (Drive + Sheets) ---
# Caminho para o JSON da service account já existente do n8n
# Service account: n8n-sheets-access@n8n-api-connections-462918.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_KEY=./credenciais/service_account.json

# --- Google Drive (pastas já existentes) ---
DRIVE_FOLDER_AGUARDANDO=1aJbfW4Y2_yPR6sOvQvKLic_TrFy7Eitc
DRIVE_FOLDER_PUBLICADOS=1JCwz32cb1YnzFqQaNTH-2UP0dJUseP4N
# Gerado automaticamente ao rodar: npm run auth:drive (conta proprietária do Drive)
DRIVE_REFRESH_TOKEN=

# --- Google Sheets ---
# Planilha "CATEGORIAS E PRODUTOS - PLATAFORMAS" (confirmado via n8n workflow)
SPREADSHEET_ID=1QnaVL8xfbT8CO0cZPLpZMKxUc3FqfGX7zSHAX3499Ow

# --- YouTube ---
YOUTUBE_CHANNEL_ID=

# --- Claude API (Anthropic) ---
# Obtido em: https://console.anthropic.com/
ANTHROPIC_API_KEY=

# --- Evolution API (WhatsApp) ---
# URL configurada no Coolify após instalação (ex: https://evolution.seudominio.com)
EVOLUTION_API_URL=
# API Key definida durante a instalação da Evolution API
EVOLUTION_API_KEY=
# Nome da instância criada na Evolution API
WHATSAPP_INSTANCE=portal-de-promos
# ID do grupo WhatsApp — confirmado via n8n workflow existente
WHATSAPP_GROUP_ID=120363406286033900@g.us

# --- Configurações do Cron ---
# Intervalo de verificação em minutos (padrão: 30)
CRON_INTERVAL_MINUTES=30

# --- Web Server ---
PORT=3000

# --- Mercado Livre Afiliado ---
# Cookie da sessão logada em mercadolivre.com.br (copiar do DevTools → Application → Cookies)
ML_AFFILIATE_COOKIE=
ML_AFFILIATE_TAG=agencia_tektus

# --- Amazon Afiliado ---
# Cookie da sessão logada em amazon.com.br com conta de afiliados ativa (SiteStripe visível na página)
AMAZON_AFFILIATE_COOKIE=

# --- Shopee Afiliado ---
# Credenciais da API oficial de afiliados: https://affiliate.shopee.com.br/open-api
SHOPEE_APP_ID=
SHOPEE_SECRET=
